# SkillBridge AI — Backend environment variables
# Copy: cp .env.example .env  →  fill in values  →  NEVER commit .env

# Required — get from https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw-your-key-here

# The deployed Vercel frontend URL (set after frontend deploy)
FRONTEND_URL=https://your-app.vercel.app

# SQLite file path (default is ./db/skillbridge.db — fine for Render disk)
# DB_PATH=/opt/render/project/src/backend/db/skillbridge.db

# Rate limiting (default: 5 requests per 60 seconds per IP)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW=60
